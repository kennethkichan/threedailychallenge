rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow users to read and write to their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allow users to read and write to their own answeredQuestions subcollection
      match /answeredQuestions/{questionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Problems can be read by any authenticated user, but only written by admins
    match /problems/{problemId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.is_admin == true;
    }

    // Disputes can be created by any authenticated user, but only read and managed by admins
    match /disputes/{disputeId} {
        allow create: if request.auth != null;
        allow read, update, delete: if request.auth != null && request.auth.token.is_admin == true;
    }
  }
}
