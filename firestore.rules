rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow users to read and write to their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allow users to read and write to their own answeredQuestions subcollection
      match /answeredQuestions/{questionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Allow read and write to the test collection only for authenticated users
    match /test-collection/{documentId} {
        allow read, write: if request.auth != null;
    }
  }
}
