rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow users to read and write to their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allow users to read and write to their own answeredQuestions subcollection
      match /answeredQuestions/{questionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Problems can be read by any authenticated user.
    match /problems/{problemId} {
      allow read: if request.auth != null;

      // Admins or your specific user account can create, update, and delete problems.
      allow create, delete: if request.auth != null && (request.auth.token.is_admin == true || request.auth.uid == 'VT5YjCvGZOcgNOCknKkmspw2E9y2');

      // Allow admins or your specific user account to perform any update.
      // Allow users to update a problem to dispute it.
      allow update: if (request.auth != null && (request.auth.token.is_admin == true || request.auth.uid == 'VT5YjCvGZOcgNOCknKkmspw2E9y2')) ||
                    (request.auth != null &&
                     request.resource.data.review_status == 'disputed' &&
                     resource.data.review_status != 'disputed');
    }

    // Disputes can be created by any authenticated user, but only read and managed by admins or your specific user account
    match /disputes/{disputeId} {
        allow create: if request.auth != null;
        allow read, update, delete: if request.auth != null && (request.auth.token.is_admin == true || request.auth.uid == 'VT5YjCvGZOcgNOCknKkmspw2E9y2');
    }
  }
}
